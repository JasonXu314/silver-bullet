!!!P DIGIT [0-9]
!!!P INT [+\-]?{DIGIT}+
!!!P NZINT [+\-]?{DIGIT}*[1-9]{DIGIT}*
!!!P DEC {INT}.[0-9]+
!!!P TEST abc|(abc)*d
!!!P ALPHA [a-zA-Z]
!!!P ALNUM [a-zA-Z0-9]

!!!T KEYWORD IF|THEN|ELSE|WHILE|DO|END|END.|WRITE|RETURN
!!!T FN FUNCTION
!!!T LPAREN \(
!!!T RPAREN \)
!!!T SC ;
!!!T COMMA ,
!!!T ASSIGN :=
!!!T GT >
!!!T IDENT {ALPHA}(_|{ALNUM})*
!!!T INT {INT}
!!!T DEC {DEC}
!!!T SCI ({DEC}|{INT})e\+{NZINT}

!!!R FUNCTION => token::FN {token::primitive::ws} token::IDENT token::LPAREN [token::IDENT {token::COMMA {token::primitive::ws} token::IDENT}] token::RPAREN;

FUNCTION max(a, b, c)
	beeg := a

	IF b > beeg THEN
		beeg := b
	END

	IF c > beeg THEN
		beeg := c
	END

	RETURN beeg
END.