!!!P DIGIT [0-9]
!!!P INT [+\-]?{DIGIT}+
!!!P NZINT [+\-]?{DIGIT}*[1-9]{DIGIT}*
!!!P DEC {INT}.[0-9]+
!!!P TEST abc|(abc)*d
!!!P ALPHA [a-zA-Z]
!!!P ALNUM [a-zA-Z0-9]

!!!T IF IF
!!!T THEN THEN
!!!T ELSE ELSE
!!!T END END
!!!T WRITE WRITE
!!!T WHILE WHILE
!!!T DO DO
!!!T ELSIF ELSIF
!!!T RETURN RETURN
!!!T FN FUNCTION
!!!T FN_END END.
!!!T LPAREN \(
!!!T RPAREN \)
!!!T SC ;
!!!T COMMA ,
!!!T ASSIGN :=
!!!T IDENT {ALPHA}(_|{ALNUM})*
!!!T INT {INT}
!!!T DEC {DEC}
!!!T SCI ({DEC}|{INT})e\+{NZINT}

!!!T MULT_OP (\*|/|AND|DIV|MOD)
!!!T ADD_OP (\+|OR|&|-)
!!!T REL_OP (<|>|#|=)

!!!R FACTOR => token::INT | token::DEC | token::IDENT | token::LPAREN rule::EXPRESSION token::RPAREN;
!!!R TERM => rule::FACTOR {token::MULT_OP rule::FACTOR};
!!!R S_EXPR => rule::TERM {token::ADD_OP rule::TERM};
!!!R EXPRESSION => rule::S_EXPR [token::REL_OP rule::S_EXPR];

!!!R ASSIGNMENT => token::IDENT token::ASSIGN rule::EXPRESSION;
!!!R WRITE_STMT => token::WRITE token::LPAREN rule::EXPRESSION token::RPAREN;
!!!R IF_STMT => token::IF rule::EXPRESSION token::THEN rule::STMT_SEQ token::END;
!!!R WHILE_STMT => token::WHILE rule::EXPRESSION token::DO rule::STMT_SEQ {token::ELSIF rule::EXPRESSION token::DO rule::STMT_SEQ} token::END;
!!!R STATEMENT => rule::ASSIGNMENT | rule::IF_STMT | rule::WHILE_STMT | rule::WRITE_STMT;
!!!R STMT_SEQ => rule::STATEMENT {token::SC rule::STATEMENT};

!!!R RET_STMT => token::RETURN rule::EXPRESSION;

!!!R PARAM_SEQ => token::IDENT {token::COMMA token::IDENT};
!!!R FN_BODY => token::SC | rule::STMT_SEQ [rule::RET_STMT] token::FN_END;
!!!R FUNCTION => token::FN token::IDENT token::LPAREN [rule::PARAM_SEQ] token::RPAREN rule::FN_BODY;

FUNCTION max(a, b, c)
	beeg := a;

	IF b > beeg THEN
		beeg := b
	END;

	IF c > beeg THEN
		beeg := c
	END;

	WRITE ( beeg )

	RETURN beeg
END.

FUNCTION fibo(n)
  x := 1 ;
  y := 2 ;
  c := 3 ;
  WHILE c < n DO 
    x := x + y ;
    y := x - y ;
    c := c + 1 
  END
  RETURN ( x )
END.
